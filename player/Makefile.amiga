# MintVID - AmigaOS (m68k) cross build.
#
# Programs:
#   mrplay    - the player: opens an RTG window and plays an AVI/MOV clip.
#   mrgui / mrgui-GT       - ReAction / OS 3.1 GadTools controllers.
#   iptvgui / iptvgui-GT   - ReAction / GadTools IPTV browsers.
#   ytgui / ytgui-GT       - ReAction / GadTools YouTube browsers.
#   mr_decode - decoder test harness: dumps frames to PPM (no display), used to
#               verify decoding on real hardware.
#
#     mrplay    UHD:clips/movie.mov
#     mr_decode test_cinepak.avi --ppm ram:frames
#
#   make -f Makefile.amiga                 # builds all programs (gcc, default)
#   make -f Makefile.amiga mrplay          # just the player
#   make -f Makefile.amiga mrplay SSL=1    # add HTTPS via AmiSSL v5
#   make -f Makefile.amiga mrplay SSL=1 SSLCERTS=1 # verify certificates
#   make -f Makefile.amiga all SSL=1 SSLCERTS=1 # IPTV/YouTube HTTPS
#   make -f Makefile.amiga release SSL=1 SSLCERTS=1 # release/*.030/.040/.060
#   make -f Makefile.amiga TOOLCHAIN=vbcc  # mr_decode via vbcc + vclib
#
# The compiler does NOT need to be on your PATH: this prefers whatever
# m68k-amigaos-gcc is on PATH, then falls back to Bebbo's usual install
# prefixes. Override if yours lives elsewhere:
#
#   make -f Makefile.amiga AMIGA_ROOT=/opt/amiga-gcc
#   make -f Makefile.amiga AMIGA_GCC=/home/me/amiga/bin/m68k-amigaos-gcc
#
# CPU defaults to the universal 68030 baseline. CPU=68040 and CPU=68060 are
# explicit performance builds; `release` creates all three without changing
# which binary a normal `make` produces. The core is integer-only and does not
# require an FPU.
#
# MintAMP's hand-asm (real/amiga_m68k_polyphase.S etc.) is linked in
# automatically for CPU=68030/68040 - the same asm bundle MintAMP's own
# Makefile.amiga uses by default for those CPUs. CPU=68060's raw asm is
# actively harmful there (it traps into software emulation - see the
# MINTAMP_CPU comment further down), so 68060 instead defaults to
# ASM60_GROUPS="lowrate060 huffman midside planars8" - the trap-free,
# real-hardware-confirmed combination (large speedup, no emulated
# multiply). Override on the command line, e.g. a clean C baseline for
# A/B comparison:
#   make -f Makefile.amiga mrplay CPU=68060 ASM60_GROUPS=
# `release` forwards ASM60_GROUPS to its CPU=68060 sub-build the same way it
# already forwards SSL/SSLCERTS/RADIO (GNU Make auto-propagates command-line
# variables to $(MAKE) recursion).

TOOLCHAIN ?= gcc
CPU ?= 68030
SUPPORTED_CPUS := 68030 68040 68060
ifeq ($(filter $(CPU),$(SUPPORTED_CPUS)),)
$(error unsupported CPU '$(CPU)' (choose $(SUPPORTED_CPUS)))
endif
CPUFLAGS := -m$(CPU)
include vendor/libavc_port/libavc.mk
SSL ?= 0
SSLCERTS ?= 0
HTTP_SSL_FLAGS =
ifneq ($(filter 1 yes true on,$(SSL)),)
HTTP_SSL_FLAGS += -DHAVE_AMISSL
endif
ifneq ($(filter 1 yes true on,$(SSLCERTS)),)
HTTP_SSL_FLAGS += -DMR_HTTP_SSL_VERIFY_PEER
endif
LIBMPEG2_ROOT = vendor/libmpeg2
LIBMPEG2_FLAGS = -I$(LIBMPEG2_ROOT) -I$(LIBMPEG2_ROOT)/include \
                 -I$(LIBMPEG2_ROOT)/libmpeg2
LIBMPEG2_SRC = $(LIBMPEG2_ROOT)/libmpeg2/alloc.c \
               $(LIBMPEG2_ROOT)/libmpeg2/cpu_accel.c \
               $(LIBMPEG2_ROOT)/libmpeg2/cpu_state.c \
               $(LIBMPEG2_ROOT)/libmpeg2/decode.c \
               $(LIBMPEG2_ROOT)/libmpeg2/header.c \
               $(LIBMPEG2_ROOT)/libmpeg2/idct.c \
               $(LIBMPEG2_ROOT)/libmpeg2/motion_comp.c \
               $(LIBMPEG2_ROOT)/libmpeg2/slice.c
CORE  = core/mr_codec.c core/mr_source.c core/mr_http.c core/mr_hls.c \
        core/mr_youtube.c \
        core/mr_demux.c core/mr_latm.c core/mr_mkv.c core/mr_avi.c core/mr_mov.c \
        core/mr_ts.c core/mr_ps.c \
        core/mr_raw_mjpeg.c core/mr_raw_mpeg4.c \
        core/mr_cinepak.c core/mr_dither.c core/mr_dither_m68k.S core/mr_ham.c core/mr_scale.c \
        core/mr_c2p.c core/mr_c2p_m68k.S core/mr_mjpeg.c core/picojpeg.c core/mr_mpeg1.c \
        core/mr_mpeg2.c $(LIBMPEG2_SRC) \
        core/mr_mpeg4.c core/mr_msmpeg4v2.c core/mr_h263.c core/mr_msvideo1.c core/mr_rle.c \
        core/mr_rawvideo.c core/mr_yuv.c core/mr_yuv_m68k.S
HARN  = tests/mr_decode.c
PLAY  = amiga/mrplay.c core/mr_play_options.c amiga/display.c amiga/display_cgx.c \
        amiga/display_p96.c amiga/display_aga.c amiga/audio_paula.c \
        audio/mr_audio_decode.c audio/mr_pcm.c
GUI_MENU = amiga/mr_gui_menu.c
GUI   = amiga/mrgui.c $(GUI_MENU) core/mr_play_options.c
IPTVGUI = amiga/iptv_reaction.c iptv/mr_iptv.c iptv/mr_iptv_json.c \
          iptv/mr_iptv_m3u.c iptv/mr_iptv_streaming.c \
          core/mr_source.c core/mr_http.c core/mr_hls.c core/mr_youtube.c \
          core/mr_play_options.c $(GUI_MENU)
YTGUI = amiga/youtube_reaction.c youtube/mr_youtube_search.c \
        core/mr_source.c core/mr_http.c core/mr_hls.c core/mr_youtube.c \
        core/mr_play_options.c $(GUI_MENU)
GUI_GT = amiga/mrgui_gadtools.c $(GUI_MENU) core/mr_play_options.c
IPTVGUI_GT = amiga/iptv_gadtools.c iptv/mr_iptv.c iptv/mr_iptv_json.c \
             iptv/mr_iptv_m3u.c iptv/mr_iptv_streaming.c \
             core/mr_source.c core/mr_http.c core/mr_hls.c core/mr_youtube.c \
             core/mr_play_options.c $(GUI_MENU)
YTGUI_GT = amiga/youtube_gadtools.c youtube/mr_youtube_search.c \
           core/mr_source.c core/mr_http.c core/mr_hls.c core/mr_youtube.c \
           core/mr_play_options.c $(GUI_MENU)
MINTAMP_ROOT ?= vendor/MintAMP

# MintAMP's own hand-tuned m68k asm (real/amiga_m68k_polyphase.S,
# amiga_m68k_planars8.S, and the AMIGA_M68K_ASM_* inline asm throughout
# real/*.c) is a real win on 68030/68040 - both implement 32x32->64
# MULS.L/MULU.L in hardware - but is actively harmful on 68060: that
# register-pair form is NOT implemented in 68060 hardware and traps into
# software emulation, dramatically slower than the plain C path (confirmed
# by MintAMP's own hardware testing). So: 68030/68040 get the full asm
# bundle unconditionally, matching MintAMP's own CPU=20/30/40 default;
# 68060 starts from the clean, trap-free C baseline and only gets
# individual asm features back via ASM60_GROUPS, exactly like a MintAMP
# `CPU=60 ASM60_GROUPS="..."` build. This block mirrors
# vendor/MintAMP/Makefile.amiga's own CPU_ASM_CPPFLAGS/CPU_ASM_SOURCES/
# ASM60_GROUPS tables (that Makefile isn't `include`-able as a fragment -
# it's a complete standalone build with its own conflicting target names -
# so this is a deliberate, commented copy); keep the two in sync if that
# file's tables change. `make -f Makefile.amiga mrplay CPU=68060
# ASM60_GROUPS="lowrate060 huffman midside planars8"` selects the same
# groups the MintAMP release build above was tested with.
MINTAMP_CPU := $(patsubst 680%,%,$(CPU))

MINTAMP_ASM_CPPFLAGS_FULL030 := \
    -DAMIGA_M68K_ASM \
    -DAMIGA_M68K_ASM_FDCT32 \
    -DAMIGA_M68K_ASM_FDCT32_UNROLL \
    -DAMIGA_FAST_POLYPHASE \
    -DAMIGA_FAST_REDUCED_TAPS \
    -DAMIGA_FAST_FDCT32_QUARTER \
    -DAMIGA_M68K_IMDCT_THIN_OUTPUT \
    -DAMIGA_FAST_SUBBAND_CAP \
    -DAMIGA_M68K_ASM_POLYPHASE \
    -DAMIGA_M68K_ASM_IMDCT \
    -DAMIGA_M68K_ASM_ANTIALIAS \
    -DAMIGA_M68K_ASM_MIDSIDE \
    -DAMIGA_M68K_ASM_INTENSITY \
    -DAMIGA_M68K_ASM_DEQUANT \
    -DAMIGA_M68K_ASM_HUFFMAN \
    -DAMIGA_M68K_ASM_JPEG_GREY \
    -DAMIGA_M68K_ASM_PLANARS8
MINTAMP_ASM_SOURCES_FULL030 := $(MINTAMP_ROOT)/real/amiga_m68k_polyphase.S \
                               $(MINTAMP_ROOT)/amiga_m68k_planars8.S

# ASM60_GROUPS: space-separated feature groups for CPU=68060 only (ignored
# otherwise). Default is "lowrate060 huffman midside planars8" -
# real-hardware confirmed on 68060, a large audio-decode speedup with none
# of the trapped register-pair multiply (lowrate060 uses the dedicated
# 68060 polyphase kernel, not the emulated one - see
# vendor/MintAMP/Makefile.amiga's own ASM60_GROUPS comment block for the
# per-group hardware-testing notes this table was ported from). Override
# on the command line (e.g. ASM60_GROUPS= for the clean C baseline, or a
# different combination to A/B) same as any other `?=` variable.
ASM60_GROUPS ?= lowrate060 huffman midside planars8
ASM60_FLAGS_huffman             := -DAMIGA_M68K_ASM_HUFFMAN
ASM60_FLAGS_dequant             := -DAMIGA_M68K_ASM_DEQUANT
ASM60_FLAGS_imdct               := -DAMIGA_M68K_ASM_IMDCT
ASM60_FLAGS_fdct32              := -DAMIGA_M68K_ASM_FDCT32 -DAMIGA_M68K_ASM_FDCT32_UNROLL
ASM60_FLAGS_antialias           := -DAMIGA_M68K_ASM_ANTIALIAS
ASM60_FLAGS_midside             := -DAMIGA_M68K_ASM_MIDSIDE
ASM60_FLAGS_intensity           := -DAMIGA_M68K_ASM_INTENSITY
ASM60_FLAGS_jpeg_grey           := -DAMIGA_M68K_ASM_JPEG_GREY
ASM60_FLAGS_planars8            := -DAMIGA_M68K_ASM_PLANARS8
ASM60_FLAGS_asm_core            := -DAMIGA_M68K_ASM
ASM60_FLAGS_fast_polyphase      := -DAMIGA_FAST_POLYPHASE
ASM60_FLAGS_fast_reduced_taps   := -DAMIGA_FAST_REDUCED_TAPS
ASM60_FLAGS_fast_subband_cap    := -DAMIGA_FAST_SUBBAND_CAP
ASM60_FLAGS_fast_fdct32_quarter := -DAMIGA_FAST_POLYPHASE -DAMIGA_FAST_FDCT32_QUARTER
ASM60_FLAGS_imdct_thin_output   := -DAMIGA_FAST_POLYPHASE -DAMIGA_M68K_IMDCT_THIN_OUTPUT
ASM60_FLAGS_asm_polyphase       := -DAMIGA_FAST_POLYPHASE -DAMIGA_M68K_ASM_POLYPHASE
ASM60_FLAGS_poly060             := -DAMIGA_M68K_POLYPHASE_68060
ASM60_FLAGS_lowrate060          := -DAMIGA_M68K_POLYPHASE_68060 -DAMIGA_FAST_POLYPHASE \
    -DAMIGA_FAST_REDUCED_TAPS -DAMIGA_FAST_SUBBAND_CAP \
    -DAMIGA_FAST_FDCT32_QUARTER -DAMIGA_M68K_IMDCT_THIN_OUTPUT
ASM60_FLAGS_full030             := $(MINTAMP_ASM_CPPFLAGS_FULL030)

ASM60_SRC_planars8      := $(MINTAMP_ROOT)/amiga_m68k_planars8.S
ASM60_SRC_asm_polyphase := $(MINTAMP_ROOT)/real/amiga_m68k_polyphase.S
ASM60_SRC_full030       := $(MINTAMP_ASM_SOURCES_FULL030)

ASM60_KNOWN := huffman dequant imdct fdct32 antialias midside intensity \
    jpeg_grey planars8 asm_core fast_polyphase fast_reduced_taps \
    fast_subband_cap fast_fdct32_quarter imdct_thin_output asm_polyphase \
    poly060 lowrate060 full030

ifeq ($(MINTAMP_CPU),60)
ASM60_BAD := $(filter-out $(ASM60_KNOWN),$(ASM60_GROUPS))
ifneq ($(ASM60_BAD),)
$(error Unknown ASM60_GROUPS: $(ASM60_BAD) -- valid groups: $(ASM60_KNOWN))
endif
# $(sort ...) both de-duplicates (groups sharing a define/source) and
# orders deterministically, so ASM60_GROUPS order never changes the flags.
MINTAMP_ASM_CPPFLAGS := $(sort $(foreach g,$(ASM60_GROUPS),$(ASM60_FLAGS_$(g))))
MINTAMP_ASM_SOURCES := $(sort $(foreach g,$(ASM60_GROUPS),$(ASM60_SRC_$(g))))
else
MINTAMP_ASM_CPPFLAGS := $(MINTAMP_ASM_CPPFLAGS_FULL030)
MINTAMP_ASM_SOURCES := $(MINTAMP_ASM_SOURCES_FULL030)
endif

MINTAMP_MP3 = $(MINTAMP_ROOT)/mp3dec.c $(MINTAMP_ROOT)/mp3tabs.c \
              $(wildcard $(MINTAMP_ROOT)/real/*.c) $(MINTAMP_ASM_SOURCES)
MINTAMP_AAC_ALL = $(wildcard $(MINTAMP_ROOT)/decoders/aac/*.c)
MINTAMP_AAC = $(filter-out $(wildcard $(MINTAMP_ROOT)/decoders/aac/sbr*.c), \
                           $(MINTAMP_AAC_ALL))
MINTAMP_FLAGS = -DAMIGA_M68K -DARDUINO -DESP8266 \
                -I$(MINTAMP_ROOT)/pub -I$(MINTAMP_ROOT)/real \
                -I$(MINTAMP_ROOT)/decoders/aac \
                -I$(MINTAMP_ROOT)/decoders/aac-arduino-shim \
                $(MINTAMP_ASM_CPPFLAGS)
LIBA52_ROOT = vendor/liba52
LIBA52_FLAGS = -I$(LIBA52_ROOT)
LIBA52_SRC = $(LIBA52_ROOT)/bit_allocate.c $(LIBA52_ROOT)/bitstream.c \
             $(LIBA52_ROOT)/downmix.c $(LIBA52_ROOT)/imdct.c \
             $(LIBA52_ROOT)/parse.c \
             $(MINTAMP_ROOT)/decoders/wma/fft-ffmpeg.c \
             $(MINTAMP_ROOT)/decoders/wma/mdct_lookup.c

# Prefer whatever m68k-amigaos-gcc is on PATH (your chosen default); only if
# none is on PATH, fall back to Bebbo's usual install prefixes.
AMIGA_ROOT ?= /opt/amiga
AMIGA_GCC  ?= $(firstword \
    $(shell command -v m68k-amigaos-gcc 2>/dev/null) \
    $(wildcard $(AMIGA_ROOT)/bin/m68k-amigaos-gcc) \
    $(wildcard /opt/amiga/bin/m68k-amigaos-gcc) \
    $(wildcard /opt/amiga-gcc/bin/m68k-amigaos-gcc) \
    $(wildcard /opt/m68k-amigaos/bin/m68k-amigaos-gcc) \
    $(wildcard $(HOME)/amiga/bin/m68k-amigaos-gcc) \
    $(wildcard $(HOME)/opt/amiga/bin/m68k-amigaos-gcc))

# Kalms' authoritative source is in Motorola/Devpac syntax, not GNU as
# syntax.  Assemble it unchanged with vasm and give the Amiga GCC linker a
# native hunk object (this toolchain does not accept vasm's ELF output). Look
# next to the selected cross-compiler first; both the assembler
# and NDK include directory remain overridable for other SDK layouts.
KALMS_SRC = vendor/kalms-c2p/normal/c2p1x1_8_c5_030.s
KALMS_OBJ = build/c2p1x1_8_c5_030.o
KALMS_VASM ?= $(firstword \
    $(wildcard $(dir $(AMIGA_GCC))vasmm68k_mot) \
    $(shell command -v vasmm68k_mot 2>/dev/null))
KALMS_ASM_INCLUDE ?= $(firstword \
    $(wildcard $(AMIGA_ROOT)/m68k-amigaos/ndk-include/lvo/exec_lib.i) \
    $(wildcard $(AMIGA_ROOT)/m68k-amigaos/include/lvo/exec_lib.i) \
    $(wildcard $(AMIGA_ROOT)/include/lvo/exec_lib.i))
KALMS_ASM_INCLUDE := $(patsubst %/lvo/exec_lib.i,%,$(KALMS_ASM_INCLUDE))

ifeq ($(TOOLCHAIN),gcc)
CORE   += core/mr_h264.c $(LIBAVC_SRC)
CC      = $(AMIGA_GCC)
# MPEG-1 (pl_mpeg in mr_mpeg1.c) is fixed-point. MR_HAVE_MPEG1 enables .mpg.
# STAGE_PROFILE=1 opts into the per-leaf-call mc/deblock/recon/intra H.264
# timing breakdown (mrplay.c's "h264 stages:" line) - off by default
# because it wraps every MC/deblock/recon/intra leaf call (tens of
# thousands per frame) with two clock() calls each, real overhead on this
# target that a normal playback build should not pay. Use for a one-off
# profiling build only: `make -f Makefile.amiga mrplay STAGE_PROFILE=1`.
STAGE_PROFILE_FLAGS =
ifeq ($(STAGE_PROFILE),1)
STAGE_PROFILE_FLAGS = -DMR_H264_STAGE_PROFILE=1
endif
# amiga/include/{libraries,inline}/Picasso96*.h: the Picasso96 SDK headers
# amiga/display_p96.c needs (p96LockBitMap etc.) are not part of the base
# AmigaOS NDK Bebbo's gcc bundles, so a copy lives in-tree instead of
# depending on the user's own toolchain install having the P96 SDK on its
# include path. -Iamiga/include is searched before the toolchain's own
# system includes, so a P96 SDK already installed there is not shadowed by
# anything except this exact pair of files.
CFLAGS  = -O2 -std=c99 $(CPUFLAGS) -noixemul -fomit-frame-pointer -Wall -Wextra \
          -DAMIGA_M68K -DMR_HAVE_MPEG1 -DMR_HAVE_H264 -DMR_M68K_ASM=1 \
          $(STAGE_PROFILE_FLAGS) \
          $(HTTP_SSL_FLAGS) $(LIBAVC_FLAGS) $(LIBAVC_GCC_FLAGS) \
          $(LIBMPEG2_FLAGS) -Iamiga/include \
          -Wno-unused-parameter -Wno-unused-variable -Wno-unused-function \
          -Wno-unused-but-set-variable -Wno-sign-compare \
          -Wno-implicit-fallthrough -Wno-maybe-uninitialized -Wno-type-limits
GUI_CFLAGS = -O2 -std=c99 $(CPUFLAGS) -noixemul -fomit-frame-pointer -Wall -Wextra
# LIBAVC_M68K_LDFLAGS (libavc.mk): redirects ih264d_decode_bin to the m68k
# asm via vendor/libavc_port/ih264d_cabac_wrap.c, without editing the
# vendored ih264d_cabac.c inside the libavc submodule. Harmless on targets
# that don't link the H.264 decoder at all (GNU ld's --wrap only errors if
# something references the original symbol with no wrapper present - not
# verified on this specific m68k-amigaos-gcc/binutils install, no AmigaOS
# toolchain on this dev host, but Bebbo's toolchain is a full binutils/ld
# port and --wrap is standard GNU ld, confirmed working the same way on the
# m68k-linux-gnu test toolchain in tests/run_m68k_check.sh).
LDFLAGS = -noixemul -lgcc $(LIBAVC_M68K_LDFLAGS)

all: mrplay mrgui iptvgui ytgui mrgui-GT iptvgui-GT ytgui-GT mr_decode

audio_task_stress: check-cc tests/amiga_audio_task_stress.c amiga/audio_paula.c
	$(CC) $(CFLAGS) -o $@ tests/amiga_audio_task_stress.c \
	    amiga/audio_paula.c $(LDFLAGS)

KALMS_CHECK = tests/mr_kalms_c2p_check.c core/mr_c2p.c core/mr_c2p_m68k.S

check-cc:
	@test -n "$(CC)" && test -x "$(CC)" || { \
	  echo "ERROR: m68k-amigaos-gcc not found."; \
	  echo "  Set AMIGA_ROOT (install prefix) or AMIGA_GCC (full path), e.g."; \
	  echo "  make -f Makefile.amiga AMIGA_ROOT=/opt/amiga"; \
	  exit 1; }
	@echo "using CC = $(CC)"

mrplay: check-cc check-mintamp check-kalms $(PLAY) $(CORE) $(KALMS_OBJ) | check-libavc
	$(CC) $(CFLAGS) $(MINTAMP_FLAGS) $(LIBA52_FLAGS) -o $@ $(PLAY) $(CORE) \
	    $(MINTAMP_MP3) $(MINTAMP_AAC) $(LIBA52_SRC) $(KALMS_OBJ) $(LDFLAGS)

check-kalms:
	@test -n "$(KALMS_VASM)" -a -x "$(KALMS_VASM)" || { \
	  echo "ERROR: vasmm68k_mot is required for the Kalms Motorola-syntax source."; \
	  echo "  Set KALMS_VASM to its full path."; exit 1; }
	@test -n "$(KALMS_ASM_INCLUDE)" || { \
	  echo "ERROR: lvo/exec_lib.i was not found in the Amiga NDK."; \
	  echo "  Set KALMS_ASM_INCLUDE to the directory containing lvo/."; exit 1; }

$(KALMS_OBJ): $(KALMS_SRC) Makefile.amiga | check-kalms
	@mkdir -p $(@D)
	$(KALMS_VASM) -Fhunk -m68030 -no-opt -I$(KALMS_ASM_INCLUDE) -o $@ $<

# As in MintAMP, mrgui opens the ReAction classes explicitly at runtime.
# No libauto archive is required by the cross-toolchain.
mrgui: check-cc $(GUI) amiga/mr_master_options.h
	$(CC) $(GUI_CFLAGS) -o $@ $(GUI) $(LDFLAGS)

iptvgui: check-cc $(IPTVGUI) iptv/mr_iptv.h amiga/mr_master_options.h
	$(CC) $(GUI_CFLAGS) $(HTTP_SSL_FLAGS) -o $@ $(IPTVGUI) $(LDFLAGS)

ytgui: check-cc $(YTGUI) youtube/mr_youtube_search.h amiga/mr_master_options.h
	$(CC) $(GUI_CFLAGS) $(HTTP_SSL_FLAGS) -o $@ $(YTGUI) $(LDFLAGS)

mrgui-GT: check-cc $(GUI_GT) amiga/mr_master_options.h
	$(CC) $(GUI_CFLAGS) -o $@ $(GUI_GT) $(LDFLAGS)

iptvgui-GT: check-cc $(IPTVGUI_GT) iptv/mr_iptv.h amiga/mr_master_options.h
	$(CC) $(GUI_CFLAGS) $(HTTP_SSL_FLAGS) -o $@ $(IPTVGUI_GT) $(LDFLAGS)

ytgui-GT: check-cc $(YTGUI_GT) youtube/mr_youtube_search.h amiga/mr_master_options.h
	$(CC) $(GUI_CFLAGS) $(HTTP_SSL_FLAGS) -o $@ $(YTGUI_GT) $(LDFLAGS)

check-mintamp:
	@test -f $(MINTAMP_ROOT)/pub/mp3dec.h -a \
	      -f $(MINTAMP_ROOT)/decoders/aac/aacdec.h || { \
	  echo "ERROR: initialise the MintAMP submodule first:"; \
	  echo "  git submodule update --init --recursive"; exit 1; }

check-libavc:
	@test -f $(LIBAVC_ROOT)/decoder/ih264d.h || { \
	  echo "ERROR: initialise the libavc submodule first:"; \
	  echo "  git submodule update --init --recursive"; exit 1; }

mr_decode: check-cc $(HARN) $(CORE) | check-libavc
	$(CC) $(CFLAGS) -o $@ $(HARN) $(CORE) $(LDFLAGS)
endif

kalms_c2p_check: check-cc check-kalms $(KALMS_CHECK) $(KALMS_OBJ)
	$(CC) $(CFLAGS) -o $@ $(KALMS_CHECK) $(KALMS_OBJ) $(LDFLAGS)

ifeq ($(TOOLCHAIN),vbcc)
# Requires VBCC + vc.config target 'aos68k'. Override CC=... if not on PATH.
CC      ?= vc
CFLAGS  = +aos68k -c99 -O2 -cpu=68030 -DAMIGA_M68K \
          $(HTTP_SSL_FLAGS) $(LIBMPEG2_FLAGS)

all: mr_decode
mr_decode: $(HARN) $(CORE)
	$(CC) $(CFLAGS) -o $@ $(HARN) $(CORE)
endif

clean:
	rm -f mrplay mrgui iptvgui ytgui mrgui-GT iptvgui-GT ytgui-GT \
	      mr_decode kalms_c2p_check $(KALMS_OBJ)
	rm -f audio_task_stress

# Build every supported CPU profile into its own ready-to-run directory.
# The final recursive build is 68030, leaving the ordinary working binaries on
# the safest baseline as well as producing all three release sets.
RELEASE_DIR ?= release
RELEASE_PROGRAMS := mrplay mrgui iptvgui ytgui mrgui-GT iptvgui-GT \
                    ytgui-GT mr_decode

define build_release_cpu
	$(MAKE) -f Makefile.amiga clean
	$(MAKE) -f Makefile.amiga TOOLCHAIN=gcc CPU=$(1) all
	@mkdir -p $(RELEASE_DIR)/MintVID$(2)
	@for program in $(RELEASE_PROGRAMS); do \
		cp "$$program" "$(RELEASE_DIR)/MintVID$(2)/$$program"; \
	done
endef

release:
	$(call build_release_cpu,68040,040)
	$(call build_release_cpu,68060,060)
	$(call build_release_cpu,68030,030)
	@echo "Release binaries written to $(RELEASE_DIR)/"
	@echo "Ready-to-run sets: MintVID030, MintVID040 and MintVID060"

.PHONY: all release clean check-cc check-mintamp check-libavc check-kalms \
	kalms_c2p_check

+static void h264_scheduler_checkpoint(int rescue_active, int rescue_priority,
+                                      int starved, int source, int holdover,
+                                      int qcount, unsigned long audio_ms,
+                                      uint64_t audio_raw, uint64_t master_clock,
+                                      uint64_t mono_clock, uint64_t front_pts,
+                                      int64_t late_us)
+{
+    BPTR fh;
+    char buf[384];
+    int n;
+
+    if (!h264_pipeline_diag_enabled || h264_scheduler_diag_written) return;
+    fh = Open((CONST_STRPTR)"RAM:MintRIVA-H264.scheduler", MODE_NEWFILE);
+    if (!fh) return;
+    n = snprintf(buf, sizeof buf,
+                 "res=%dx%d rescue=%d priority=%d starved=%d source=%d "
+                 "holdover=%d qcount=%d audio_ms=%lu audio_raw=%lu "
+                 "master=%lu mono=%lu front_pts=%lu late=%ld\n",
+                 h264_pipeline_width, h264_pipeline_height,
+                 rescue_active, rescue_priority, starved, source, holdover,
+                 qcount, audio_ms, (unsigned long)audio_raw,
+                 (unsigned long)master_clock, (unsigned long)mono_clock,
+                 (unsigned long)front_pts, (long)late_us);
+    if (n > 0) {
+        LONG bytes = n < (int)sizeof buf ? (LONG)n : (LONG)(sizeof buf - 1);
+        Write(fh, (APTR)buf, bytes);
+    }
+    Close(fh);
+    h264_scheduler_diag_written = 1;
+}
+
+static void h264_firstdisplay_checkpoint(const char *stage,
+                                         const unsigned char *rgb,
+                                         int width, int height, int stride)
+{
+    BPTR fh;
+    char buf[384];
+    int n;
+    size_t bytes = 0, step = 1, i, mid = 0;
+    unsigned minv = 255, maxv = 0;
+    unsigned r0 = 0, g0 = 0, b0 = 0, rm = 0, gm = 0, bm = 0;
+    uint32_t hash = 2166136261u;
+
+    if (!h264_pipeline_diag_enabled || !stage) return;
+    if (rgb && width > 0 && height > 0 && stride > 0) {
+        bytes = (size_t)stride * (size_t)height;
+        step = bytes / 257u;
+        if (!step) step = 1;
+        for (i = 0; i < bytes; i += step) {
+            unsigned v = rgb[i];
+            if (v < minv) minv = v;
+            if (v > maxv) maxv = v;
+            hash ^= (uint32_t)v;
+            hash *= 16777619u;
+        }
+        r0 = rgb[0]; g0 = rgb[1]; b0 = rgb[2];
+        mid = (size_t)(height / 2) * (size_t)stride +
+              (size_t)(width / 2) * 3u;
+        if (mid + 2 < bytes) {
+            rm = rgb[mid]; gm = rgb[mid + 1]; bm = rgb[mid + 2];
+        }
+    } else {
+        minv = 0;
+    }
+    fh = Open((CONST_STRPTR)"RAM:MintRIVA-H264.firstdisplay", MODE_NEWFILE);
+    if (!fh) return;
+    n = snprintf(buf, sizeof buf,
+                 "stage=%s res=%dx%d stride=%d bytes=%lu "
+                 "rgb0=%u,%u,%u mid=%u,%u,%u min=%u max=%u hash=%08lx\n",
+                 stage, width, height, stride, (unsigned long)bytes,
+                 r0, g0, b0, rm, gm, bm, minv, maxv, (unsigned long)hash);
+    if (n > 0) {
+        LONG out = n < (int)sizeof buf ? (LONG)n : (LONG)(sizeof buf - 1);
+        Write(fh, (APTR)buf, out);
+    }
+    Close(fh);
+}
